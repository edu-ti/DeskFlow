# ============================================================
# DeskFlow — backend environment template
# Copie este arquivo para `.env` e preencha os valores reais.
# NÃO versione o `.env` (está no .gitignore).
# ============================================================

# --- Aplicação ---
PORT=3000
JWT_SECRET=change-me

# --- Banco de dados (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=deskflow
DB_PASS=change-me
DB_NAME=deskflow_db
# true apenas em dev; em produção defina false e use migrations
DB_SYNCHRONIZE=true

# --- Redis (BullMQ / filas) ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Elasticsearch (busca) ---
ELASTICSEARCH_NODE=http://localhost:9200

# --- Email: SMTP (envio) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=suporte@example.com
SMTP_PASS=change-me
SMTP_FROM="DeskFlow Support <suporte@example.com>"

# --- Email: IMAP (entrada) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=suporte@example.com
IMAP_PASS=change-me

# --- Email: POP3 (entrada) ---
POP3_HOST=pop.example.com
POP3_PORT=995
POP3_USER=suporte@example.com
POP3_PASS=change-me

# --- Email: Microsoft Graph / Exchange Online ---
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAILBOX=

# --- Canais ---
OPENAI_API_KEY=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
